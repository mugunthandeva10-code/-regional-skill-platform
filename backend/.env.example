# App settings — override in .env
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/skill_platform

# AI provider (optional). If unset, fallback to rule-based / demo.
# Examples:
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=...
# LLM_PROVIDER=openai

# Resume upload
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=uploads

# Demo mode
DEMO_AUTO_SEED=true
